// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String?
  name          String?
  role          String    @default("CUSTOMER") // CUSTOMER, ADMIN
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  orders        Order[]
  designs       BraceletDesign[]
  sessions      Session[]
  cart          Cart?

  @@index([email])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Product {
  id          String    @id @default(uuid())
  name        String
  description String
  category    String    // CHARM, BEAD, SPACER, etc.
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  variants    Variant[]
}

model Material {
  id          String    @id @default(uuid())
  name        String    // e.g. "Amethyst", "Silver", "Gold"
  hardness    Float?
  density     Float?
  color       String?
  properties  String?   // JSON string or simple text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  variants    Variant[]
}

model Variant {
  id          String    @id @default(uuid())
  productId   String
  materialId  String?
  sku         String    @unique
  size        Float?    // Size in mm
  quality     String?   // AAA, AA, etc.
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  product     Product   @relation(fields: [productId], references: [id])
  material    Material? @relation(fields: [materialId], references: [id])
  
  inventory   InventoryLedger[]
  pricing     PriceHistory[]

  @@index([productId])
  @@index([materialId])
  @@index([sku])
}

model InventoryLedger {
  id          String    @id @default(uuid())
  variantId   String
  type        String    // RESERVE, RELEASE, REPLENISH, DEPLETE
  quantity    Int
  notes       String?
  createdAt   DateTime  @default(now())

  variant     Variant   @relation(fields: [variantId], references: [id])

  @@index([variantId])
}

model PriceHistory {
  id          String    @id @default(uuid())
  variantId   String
  price       Float
  effectiveFrom DateTime @default(now())
  effectiveTo   DateTime?

  variant     Variant   @relation(fields: [variantId], references: [id])

  @@index([variantId])
}

model BraceletDesign {
  id          String    @id @default(uuid())
  userId      String?
  name        String
  items       String    // JSON string for SQLite (Prisma supports Json for postgres, but String for SQLite)
  materialIds String    // JSON array string for indexes
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user        User?     @relation(fields: [userId], references: [id])

  @@index([userId])
}

/// A ready-made piece that physically exists and is sold as-is.
///
/// Deliberately separate from Product/Variant: those are bead-level raw
/// materials (category CHARM/BEAD/SPACER, size in mm), not finished goods.
/// Stock here is a plain count because each ready-made bracelet is one
/// discrete physical object - the InventoryLedger's reserve/commit model is
/// for consumable bead stock and would be the wrong shape.
model ShopItem {
  id             String    @id @default(uuid())
  slug           String    @unique // used in the /shop/:slug URL
  name           String
  tagline        String?
  description    String?

  /// Authoritative price. Unlike custom designs - whose markup/labor inputs
  /// live only in client state - a ready-made item's price is known server
  /// side, so checkout must read it from here and ignore any client figure.
  price          Float
  status         String    @default("DRAFT") // DRAFT, ACTIVE, SOLD_OUT, ARCHIVED
  stockQty       Int       @default(0)

  /// JSON array of gemstone names, same shape as DesignPreset.pattern in
  /// src/data.ts. Drives the secondary 3D view and "customise this" hand-off.
  composition    String?
  sizeMm         Int?      // bead diameter the piece was strung at
  wristMm        Int?      // so the 3D view renders true to size
  ease           Int?

  heroImage      String?
  /// Convention-based spin frames: `${spinBasePath}/frame-01.webp` .. frame-NN.
  /// Stored as a path + count rather than 24 rows per item.
  spinBasePath   String?
  spinFrameCount Int       @default(0)
  galleryImages  String?   // JSON array of paths

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([slug])
  @@index([status])
}

model Order {
  id          String    @id @default(uuid())
  userId      String?
  status      String    // PENDING, PAID, MANUFACTURING, SHIPPED, DELIVERED, CANCELLED
  totalAmount Float
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User?     @relation(fields: [userId], references: [id])
  items       OrderItem[]
  payment     Payment?
  jobs        ManufacturingJob[]
  shipments   Shipment[]

  @@index([userId])
}

model OrderItem {
  id          String    @id @default(uuid())
  orderId     String
  type        String    // CUSTOM_BRACELET, INDIVIDUAL_ITEM
  quantity    Int
  price       Float     // Historical price snapshot
  configuration String? // JSON string describing the exact bead configuration
  metadata    String?   // JSON string for other metadata

  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Payment {
  id          String    @id @default(uuid())
  orderId     String    @unique
  provider    String    // PAYMONGO, STRIPE, PAYPAL
  status      String    // AUTHORIZED, CAPTURED, FAILED, REFUNDED
  amount      Float
  referenceId String?   // Gateway reference
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model ManufacturingJob {
  id          String    @id @default(uuid())
  orderId     String
  status      String    // QUEUED, STRINGING, KNOTTING, INSPECTION, PACKAGED
  workerId    String?   // Could be user id of an admin/worker
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Shipment {
  id          String    @id @default(uuid())
  orderId     String
  status      String    // PREPARING, DISPATCHED, DELIVERED
  trackingNum String?
  carrier     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Cart {
  id          String     @id @default(uuid())
  userId      String?    @unique
  sessionId   String?    @unique // For guest carts
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       CartItem[]

  user        User?      @relation(fields: [userId], references: [id])
}

model CartItem {
  id          String   @id @default(uuid())
  cartId      String
  type        String   // CUSTOM_BRACELET, INDIVIDUAL_ITEM
  quantity    Int      @default(1)
  configuration String? // JSON string
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cart        Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@index([cartId])
}
